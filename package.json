{
  "name": "study-agent",
  "version": "1.0.0",
  "scripts": {
    "agent": "tsx --env-file-if-exists=.env src/cli.ts",
    "trace": "tsx src/show-trace.ts",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "eval:compare": "tsx evals/compare.ts",
    "judge:calibrate": "tsx --env-file-if-exists=.env evals/calibrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": "true"
}
